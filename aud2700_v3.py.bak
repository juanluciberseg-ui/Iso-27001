        ('Get-Service | Select-Object * | Format-List', "services.txt", "Servicios"),
        ('Get-Process | Select-Object * | Format-List', "processes.txt", "Procesos"),
        ('Get-ScheduledTask | Select-Object TaskName,TaskPath,State,Author '
         '| Format-Table -AutoSize', "tasks.txt", "Tareas programadas"),
        ('Get-CimInstance Win32_StartupCommand | Select-Object * | Format-List',
         "startup.txt", "Startup"),
    ]
    for ps, fname, label in ps_cmds:
        ret, out, _ = run_cmd(f'powershell -Command "{ps}"', timeout=120)
        if ret == 0:
            fp = os.path.join(evid_dir, fname)

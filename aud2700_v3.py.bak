def verify_tools_at_startup():
    clear()
    banner()
    if REMOTE_MODE:
        print(color(f"[*] VERIFICACION DE HERRAMIENTAS EN OBJETIVO REMOTO ({REMOTE_HOST})\n", C.H))
        is_linux = (REMOTE_OS == "linux")
    else:
        print(color("[*] VERIFICACION INICIAL DE HERRAMIENTAS\n", C.H))
        is_linux = platform.system() != "Windows"
    tools = LINUX_TOOLS if is_linux else WINDOWS_TOOLS
    missing = []
    installed = []
    for tool, info in tools.items():
        check_name = tool if is_linux else info["cmd"]
        if check_tool(check_name):
            installed.append((tool, info))
        else:
            missing.append((tool, info))
    total = len(tools)
    print(color(f"  Disponibles: {len(installed)}/{total}", C.G))
    print(color(f"  Faltantes:   {len(missing)}/{total}\n", C.W if missing else C.G))
    if missing:
        print(color("--- FALTANTES ---", C.F))
        for tool, info in missing:
            crit = "[CRITICO]" if info["critico"] else "[Opcional]"
            print(color(f"  {crit} {tool:20} - {info['desc']}", C.F if info["critico"] else C.W))
        print()
        if is_linux:
            try:
                ans = safe_input("Instalar herramientas faltantes? [S/n]: ", "S").upper()
                if ans == 'S':
                    install_missing_linux(missing)
            except (EOFError, KeyboardInterrupt):
                print(CTRL_Z_MSG)
                return
        else:
            print(color("[!] En Windows instale manualmente.", C.W))
            safe_input("Presione ENTER...")
    else:
        print(color("[+] Todas las herramientas disponibles.", C.G))
        safe_input("Presione ENTER...")


def install_missing_linux(missing_list):
    print(color("\n[*] Instalando...", C.C))
    pkgs = set()
    for tool, info in missing_list:
        pkgs.add(info.get("pkg", tool))
    pkg_str = " ".join(sorted(pkgs))
    if check_tool("apt"):
        cmd = f"apt-get update && apt-get install -y {pkg_str}"
    elif check_tool("yum"):
        cmd = f"yum install -y {pkg_str}"
    elif check_tool("dnf"):
        cmd = f"dnf install -y {pkg_str}"
    elif check_tool("pacman"):
        cmd = f"pacman -S --noconfirm {pkg_str}"
    else:
        print(color("[!] No se detecto gestor de paquetes.", C.F))
        return
    if REMOTE_MODE or SUDO_CACHED or IS_ADMIN:
        ret, _, err = run_cmd(cmd, shell=True, capture=False, timeout=300, use_sudo=True)
        if ret == 0:
            print(color("[+] Instalacion completada.", C.G))
        else:
            print(color(f"[!] Error: {err[-300:]}", C.F))
    else:
        print(color("[!] Sin privilegios para instalar.", C.F))
    safe_input("Presione ENTER...")


def collect_audit_data():
    global REPORT_COUNTER
    REPORT_COUNTER = 0
    clear()
    banner()
    print(color("[*] CONFIGURACION DE DATOS DE AUDITORIA\n", C.H))
    try:
        audit_data["organizacion"] = safe_input("  Organizacion: ")
        audit_data["alcance"] = safe_input("  Alcance: ", "SGSI")
        audit_data["auditor"] = safe_input("  Auditor: ")
        audit_data["fecha_auditoria"] = datetime.datetime.now().strftime("%Y-%m-%d")

        # Si habia una conexion remota de una auditoria previa en esta misma sesion, ciérrala.
        if REMOTE_MODE:
            disconnect_remote_target()

        modo = safe_input("  Modo de auditoria [L]ocal / [R]emoto (SSH/WinRM) [L]: ", "L").upper()
        if modo == "R":
            conectado = connect_remote_target()
            if not conectado:
                print(color("[!] No se pudo conectar. Continuando en modo LOCAL.", C.W))
                safe_input("Presione ENTER...")

        if not REMOTE_MODE:
            audit_data["ip_objetivo"] = safe_input("  IP(s) objetivo: ", "127.0.0.1")
            audit_data["modo_auditoria"] = "LOCAL"
        audit_data["dominio"] = safe_input("  Dominio(s): ", "N/A")
        audit_data["contacto"] = safe_input("  Contacto: ", "N/A")
        audit_data["ubicacion"] = safe_input("  Ubicacion: ", "N/A")
        audit_data["norma"] = safe_input("  Norma [ISO/IEC 27001:2022]: ", "ISO/IEC 27001:2022")
        if REMOTE_MODE:
            # hostname/SO se obtienen mejor consultando al objetivo; se guarda un valor
            # provisional aqui, y verify_tools_at_startup() vuelve a validarlo tras conectar.
            audit_data["hostname"] = REMOTE_HOST
            audit_data["sistema_operativo"] = f"Remoto ({REMOTE_OS})"
        else:
            audit_data["hostname"] = platform.node()
            audit_data["sistema_operativo"] = f"{platform.system()} {platform.release()}"
        default_dir = f"ISO27001_Audit_{audit_data['organizacion']}_{datetime.datetime.now().strftime('%Y%m%d_%H%M%S')}"
        out = safe_input(f"  Directorio [{default_dir}]: ", default_dir)
        audit_data["output_dir"] = os.path.abspath(out)
        audit_data["id_auditoria"] = f"AUD-{audit_data['organizacion'][:3].upper()}-{datetime.datetime.now().strftime('%Y%m%d')}"
        ensure_dir(audit_data["output_dir"])
        ensure_dir(os.path.join(audit_data["output_dir"], "informes"))
        ensure_dir(os.path.join(audit_data["output_dir"], "evidencias"))
        ensure_dir(os.path.join(audit_data["output_dir"], "export"))
        meta = os.path.join(audit_data["output_dir"], "00_METADATA.json")
        save_file(meta, json.dumps(audit_data, indent=4, ensure_ascii=False))
        print(color(f"\n[+] Directorio: {audit_data['output_dir']}", C.G))
        print(color(f"[+] ID: {audit_data['id_auditoria']}", C.G))
        safe_input("Presione ENTER...")
        if REMOTE_MODE:
            # Vuelve a comprobar herramientas, esta vez contra el objetivo remoto real.
            verify_tools_at_startup()
        return True
    except (EOFError, KeyboardInterrupt):
        raise
    except Exception as e:
        print(color(f"[!] Error: {e}", C.F))
        return False


def show_audit_info():
    print(color("\n--- DATOS AUDITORIA ---", C.C))
    for k, v in audit_data.items():
        if v:
            print(f"  {k:20}: {v}")
    if REMOTE_MODE:
        print(color(f"  {'conexion':20}: REMOTA -> {REMOTE_USER}@{REMOTE_HOST}:{REMOTE_PORT} ({REMOTE_OS})", C.W))
    else:
        print(color(f"  {'conexion':20}: LOCAL (este equipo)", C.C))
    print()
    # =============================================================================
# LINUX TESTS
# =============================================================================
def linux_system_logs():
    evid_dir = ensure_dir(os.path.join(audit_data["output_dir"], "evidencias", "01_sistema"))
    hallazgos, ev_files, datos_tecnicos = [], [], ""
    print(color("  [*] Logs sistema (A.12.4.1)...", C.C))
    if check_tool("journalctl"):
        ret, out, _ = run_cmd("journalctl --no-pager -n 5000", use_sudo=True, timeout=120)
        if ret == 0:
            fp = os.path.join(evid_dir, "journalctl.txt")
            save_file(fp, out)
            ev_files.append(fp)
            datos_tecnicos += f"\n--- JOURNALCTL ---\n{out[:30000]}"
            hallazgos.append("Logs systemd recopilados.")
    if check_tool("dmesg"):
        ret, out, _ = run_cmd("dmesg --level=err,warn,info", use_sudo=True)
        if ret == 0:
            fp = os.path.join(evid_dir, "dmesg.txt")
            save_file(fp, out)
            ev_files.append(fp)
            datos_tecnicos += f"\n--- DMESG ---\n{out[:20000]}"
            hallazgos.append("Mensajes kernel recopilados.")
    for logf in ["/var/log/syslog", "/var/log/messages", "/var/log/kern.log"]:
        if path_exists(logf):
            ret, out, _ = run_cmd(f"tail -n 2000 {logf}", use_sudo=True)
            if ret == 0:
                fp = os.path.join(evid_dir, os.path.basename(logf) + ".txt")
                save_file(fp, out)
                ev_files.append(fp)
                datos_tecnicos += f"\n--- {logf} ---\n{out[:20000]}"
                hallazgos.append(f"{logf} recopilado.")
    ret, out, _ = run_cmd("uptime && cat /proc/loadavg")
    if ret == 0:
        datos_tecnicos += f"\n--- UPTIME ---\n{out}"
    cumpl = "Cumple" if len(ev_files) >= 2 else "Parcial"
    sev = "Baja" if cumpl == "Cumple" else "Media"
    rec = ("Mantener retencion de logs. Verificar rotacion e integridad."
           if cumpl == "Cumple"
           else "Implementar centralizacion de logs (SIEM) y retencion minima 12 meses.")
    return generate_iso_report(
        next_report_id("SYS"), "A.12.4.1", "Registros de eventos del sistema",
        "Verificacion de disponibilidad, integridad y retencion de registros de eventos.",
        "\n".join(hallazgos), ev_files, datos_tecnicos, cumpl, sev, rec,
        ["ISO/IEC 27001:2022 A.12.4.1", "ISO/IEC 27002:2022 8.15"]
    )


def linux_auth_logs():
    evid_dir = ensure_dir(os.path.join(audit_data["output_dir"], "evidencias", "02_autenticacion"))
    hallazgos, ev_files, datos_tecnicos = [], [], ""
    print(color("  [*] Autenticacion (A.9.4)...", C.C))
    for cmd, label, fname in [
        ("last -a -n 500", "LAST", "last.txt"),
        ("lastlog", "LASTLOG", "lastlog.txt"),
        ("faillog -a", "FAILLOG", "faillog.txt")
    ]:
        if check_tool(cmd.split()[0]):
            ret, out, _ = run_cmd(cmd, use_sudo=True)
            if ret == 0:
                fp = os.path.join(evid_dir, fname)
                save_file(fp, out)
                ev_files.append(fp)
                datos_tecnicos += f"\n--- {label} ---\n{out[:15000]}"
                hallazgos.append(f"{label} recopilado.")
    for logf in ["/var/log/auth.log", "/var/log/secure"]:
        if path_exists(logf):
            ret, out, _ = run_cmd(f"tail -n 3000 {logf}", use_sudo=True)
            if ret == 0:
                fp = os.path.join(evid_dir, os.path.basename(logf) + ".txt")
                save_file(fp, out)
                ev_files.append(fp)
                datos_tecnicos += f"\n--- {logf} ---\n{out[:30000]}"
                hallazgos.append(f"{logf} recopilado.")
    for logf, label in [("/var/log/wtmp", "wtmp"), ("/var/log/btmp", "btmp")]:
        if path_exists(logf):
            ret, out, _ = run_cmd(f"last -f {logf}", use_sudo=True)
            if ret == 0:
                fp = os.path.join(evid_dir, f"{label}.txt")
                save_file(fp, out)
                ev_files.append(fp)
                datos_tecnicos += f"\n--- {label.upper()} ---\n{out[:15000]}"
                hallazgos.append(f"{label} volcado.")
    if path_exists("/etc/sudoers"):
        ret, out, _ = run_cmd("cat /etc/sudoers", use_sudo=True)
        if ret == 0:
            fp = os.path.join(evid_dir, "sudoers.txt")
            save_file(fp, out)
            ev_files.append(fp)
            datos_tecnicos += f"\n--- SUDOERS ---\n{out[:10000]}"
            hallazgos.append("Sudoers recopilado.")
    cumpl = "Cumple" if len(ev_files) >= 3 else "Parcial"
    sev = "Baja" if cumpl == "Cumple" else "Alta"
    rec = ("Verificar timestamp, origen y resultado en logs. Implementar alertas ante fallos."
           if cumpl == "Cumple"
           else "Implementar registro detallado de autenticacion. Configurar bloqueo de cuenta.")
    return generate_iso_report(
        next_report_id("AUTH"), "A.9.4.2, A.9.4.3", "Gestion de acceso seguro",
        "Revision de registros de autenticacion, autorizacion y gestion de accesos.",
        "\n".join(hallazgos), ev_files, datos_tecnicos, cumpl, sev, rec,
        ["ISO/IEC 27001:2022 A.9.4.2", "ISO/IEC 27002:2022 5.17"]
    )


def linux_user_info():
    evid_dir = ensure_dir(os.path.join(audit_data["output_dir"], "evidencias", "03_usuarios"))
    hallazgos, ev_files, datos_tecnicos = [], [], ""
    print(color("  [*] Usuarios (A.9.2)...", C.C))
    for fpath in ["/etc/passwd", "/etc/shadow", "/etc/group", "/etc/gshadow",
                  "/etc/login.defs", "/etc/pam.conf"]:
        if path_exists(fpath):
            ret, out, _ = run_cmd(f"cat {fpath}", use_sudo=True)
            if ret == 0:
                fp = os.path.join(evid_dir, os.path.basename(fpath) + ".txt")
                save_file(fp, out)
                ev_files.append(fp)
                datos_tecnicos += f"\n--- {fpath} ---\n{out[:10000]}"
                hallazgos.append(f"{fpath} recopilado.")
    ret, out, _ = run_cmd("awk -F: '$7 !~ /nologin|false/ {print $1\" \"$7}' /etc/passwd")
    if ret == 0:
        datos_tecnicos += f"\n--- USERS WITH SHELL ---\n{out}"
        shell_users = [l for l in out.strip().split("\n") if l.strip()]
        hallazgos.append(f"Usuarios con shell: {len(shell_users)}.")
    ret, out, _ = run_cmd("awk -F: '$3 == 0 {print $1}' /etc/passwd")
    if ret == 0:
        datos_tecnicos += f"\n--- UID 0 ---\n{out}"
        hallazgos.append(f"UID 0: {out.strip()}.")
    if check_tool("getent"):
        ret, out, _ = run_cmd("getent passwd")
        if ret == 0:
            fp = os.path.join(evid_dir, "getent.txt")
            save_file(fp, out)
            ev_files.append(fp)
            datos_tecnicos += f"\n--- GETENT ---\n{out[:10000]}"
    cumpl = "Cumple" if len(ev_files) >= 4 else "Parcial"
    sev = "Baja" if cumpl == "Cumple" else "Media"
    rec = ("Mantener inventario de usuarios. Revisar cuentas inactivas."
           if cumpl == "Cumple"
           else "Implementar proceso formal de registro/baja. Revisar privilegios admin.")
    return generate_iso_report(
        next_report_id("USER"), "A.9.2.1, A.9.2.2", "Registro y gestion de usuarios",
        "Verificacion de gestion de identidades, cuentas y privilegios.",
        "\n".join(hallazgos), ev_files, datos_tecnicos, cumpl, sev, rec,
        ["ISO/IEC 27001:2022 A.9.2.1", "ISO/IEC 27002:2022 5.15"]
    )



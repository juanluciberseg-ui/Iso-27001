            ev_files.append(fp)
            datos_tecnicos += f"\n--- IPTABLES ---\n{out[:15000]}"
            hallazgos.append("Reglas iptables recopiladas.")
    if check_tool("ufw"):
        ret, out, _ = run_cmd("ufw status verbose", use_sudo=True)
        if ret == 0:
            fp = os.path.join(evid_dir, "ufw.txt")
            save_file(fp, out)
            ev_files.append(fp)
            datos_tecnicos += f"\n--- UFW ---\n{out}"
            hallazgos.append("Estado UFW recopilado.")
    for fpath in ["/etc/hosts.allow", "/etc/hosts.deny"]:
        if path_exists(fpath):
            ret, out, _ = run_cmd(f"cat {fpath}")
            if ret == 0:
                fp = os.path.join(evid_dir, os.path.basename(fpath) + ".txt")
                save_file(fp, out)
                ev_files.append(fp)
                datos_tecnicos += f"\n--- {fpath} ---\n{out}"
    cumpl = "Cumple" if len(ev_files) >= 3 else "Parcial"
    sev = "Baja" if cumpl == "Cumple" else "Alta"
    rec = ("Documentar topologia. Implementar segmentacion y controles de acceso."
           if cumpl == "Cumple"
           else "Implementar firewall de host, segmentar red y documentar servicios.")
    return generate_iso_report(
        next_report_id("NET"), "A.13.1.1, A.13.1.2", "Controles de red",
        "Revision de configuracion de red, firewall y servicios expuestos.",
        "\n".join(hallazgos), ev_files, datos_tecnicos, cumpl, sev, rec,
        ["ISO/IEC 27001:2022 A.13.1.1", "ISO/IEC 27002:2022 8.20"]
    )


def linux_audit_framework():
    evid_dir = ensure_dir(os.path.join(audit_data["output_dir"], "evidencias", "05_auditoria"))
    hallazgos, ev_files, datos_tecnicos = [], [], ""
    print(color("  [*] Framework auditoria (A.12.4)...", C.C))
    if check_tool("auditctl"):
        ret, out, _ = run_cmd("auditctl -l", use_sudo=True)
        if ret == 0:
            fp = os.path.join(evid_dir, "auditctl.txt")
            save_file(fp, out)
            ev_files.append(fp)
            datos_tecnicos += f"\n--- AUDITCTL ---\n{out[:15000]}"
            hallazgos.append("Reglas de auditoria activas recopiladas.")
    if check_tool("aureport"):
        for opt, label in [
            ("--login --summary -i", "login"),
            ("--user -i --summary", "user"),
            ("--file -i --summary", "file")
        ]:
            ret, out, _ = run_cmd(f"aureport {opt}", use_sudo=True, timeout=120)
            if ret == 0:
                fp = os.path.join(evid_dir, f"aureport_{label}.txt")
                save_file(fp, out)
                ev_files.append(fp)
                datos_tecnicos += f"\n--- AUREPORT {label.upper()} ---\n{out[:15000]}"
                hallazgos.append(f"Aureport {label} generado.")
    if check_tool("ausearch"):
        ret, out, _ = run_cmd("ausearch -m USER_LOGIN -ts recent", use_sudo=True, timeout=120)
        if ret == 0:
            fp = os.path.join(evid_dir, "ausearch.txt")
            save_file(fp, out)
            ev_files.append(fp)
            datos_tecnicos += f"\n--- AUSEARCH ---\n{out[:15000]}"
            hallazgos.append("Busqueda USER_LOGIN realizada.")
    if path_exists("/var/log/audit"):
        ret, out, _ = run_cmd("ls -la /var/log/audit/", use_sudo=True)
        if ret == 0:
            datos_tecnicos += f"\n--- AUDIT DIR ---\n{out}"
            hallazgos.append("Directorio audit verificado.")
    cumpl = "Cumple" if len(ev_files) >= 2 else "Parcial"
    sev = "Baja" if cumpl == "Cumple" else "Alta"
    rec = ("Mantener audit activo. Revisar reglas y proteger logs."
           if cumpl == "Cumple"
           else "Implementar Linux Audit Framework. Monitorear archivos criticos.")
    return generate_iso_report(
        next_report_id("AUD"), "A.12.4.1, A.12.4.2", "Framework de auditoria",
        "Evaluacion del framework de auditoria y proteccion de registros.",
        "\n".join(hallazgos), ev_files, datos_tecnicos, cumpl, sev, rec,
        ["ISO/IEC 27001:2022 A.12.4.1", "ISO/IEC 27002:2022 8.15"]
    )


def linux_processes_services():
    evid_dir = ensure_dir(os.path.join(audit_data["output_dir"], "evidencias", "06_procesos"))
    hallazgos, ev_files, datos_tecnicos = [], [], ""
    print(color("  [*] Procesos y servicios (A.12.4 / A.8.1)...", C.C))
    if check_tool("ps"):
        ret, out, _ = run_cmd("ps auxww")
        if ret == 0:
            fp = os.path.join(evid_dir, "ps_aux.txt")
            save_file(fp, out)
            ev_files.append(fp)
            datos_tecnicos += f"\n--- PS AUX ---\n{out[:20000]}"
            hallazgos.append("Procesos activos recopilados.")
    if check_tool("systemctl"):
        ret, out, _ = run_cmd("systemctl list-units --type=service --state=running")
        if ret == 0:
            fp = os.path.join(evid_dir, "systemctl_running.txt")
            save_file(fp, out)
            ev_files.append(fp)
            datos_tecnicos += f"\n--- SYSTEMCTL RUNNING ---\n{out[:15000]}"
            hallazgos.append("Servicios en ejecucion listados.")
        ret, out, _ = run_cmd("systemctl list-unit-files --state=enabled")
        if ret == 0:
            fp = os.path.join(evid_dir, "systemctl_enabled.txt")
            save_file(fp, out)
            ev_files.append(fp)
            datos_tecnicos += f"\n--- SYSTEMCTL ENABLED ---\n{out[:10000]}"
    if check_tool("lsof"):
        ret, out, _ = run_cmd("lsof -nP | head -500", use_sudo=True, timeout=60)
        if ret == 0:
            fp = os.path.join(evid_dir, "lsof.txt")
            save_file(fp, out)
            ev_files.append(fp)
            datos_tecnicos += f"\n--- LSOF ---\n{out[:20000]}"
            hallazgos.append("Archivos abiertos recopilados.")
    ret, out, _ = run_cmd("cat /etc/crontab", use_sudo=True)
    if ret == 0:
        fp = os.path.join(evid_dir, "crontab.txt")
        save_file(fp, out)
        ev_files.append(fp)
        datos_tecnicos += f"\n--- CRONTAB ---\n{out}"
        hallazgos.append("Crontab recopilado.")
    if path_exists("/etc/cron.d"):
        ret, out, _ = run_cmd("ls -la /etc/cron.d/ && cat /etc/cron.d/* 2>/dev/null", use_sudo=True)
        if ret == 0:
            fp = os.path.join(evid_dir, "cron_d.txt")
            save_file(fp, out)
            ev_files.append(fp)
            datos_tecnicos += f"\n--- CRON.D ---\n{out[:10000]}"
    ret, out, _ = run_cmd("atq", use_sudo=True)
    if ret == 0 and out.strip():
        fp = os.path.join(evid_dir, "atq.txt")
        save_file(fp, out)
        ev_files.append(fp)
        datos_tecnicos += f"\n--- ATQ ---\n{out}"
        hallazgos.append("Tareas at detectadas.")
    cumpl = "Cumple" if len(ev_files) >= 3 else "Parcial"
    sev = "Baja" if cumpl == "Cumple" else "Media"
    rec = ("Mantener inventario de servicios. Deshabilitar innecesarios."
           if cumpl == "Cumple"
           else "Documentar servicios. Implementar hardening y minimizacion.")
    return generate_iso_report(
        next_report_id("PROC"), "A.12.4.1, A.8.1.2", "Procesos y servicios",
        "Revision de procesos activos, servicios y tareas programadas.",
        "\n".join(hallazgos), ev_files, datos_tecnicos, cumpl, sev, rec,
        ["ISO/IEC 27001:2022 A.12.4.1", "ISO/IEC 27002:2022 8.8"]
    )


def linux_filesystem():
    evid_dir = ensure_dir(os.path.join(audit_data["output_dir"], "evidencias", "07_filesystem"))
    hallazgos, ev_files, datos_tecnicos = [], [], ""
    print(color("  [*] Filesystem (A.8.1)...", C.C))
    ret, out, _ = run_cmd("cat /proc/mounts", use_sudo=True)
    if ret == 0:
        fp = os.path.join(evid_dir, "mounts.txt")
        save_file(fp, out)
        ev_files.append(fp)
        datos_tecnicos += f"\n--- MOUNTS ---\n{out[:10000]}"
        hallazgos.append("Mounts recopilados.")
    if path_exists("/etc/fstab"):
        ret, out, _ = run_cmd("cat /etc/fstab")
        if ret == 0:
            fp = os.path.join(evid_dir, "fstab.txt")
            save_file(fp, out)
            ev_files.append(fp)
            datos_tecnicos += f"\n--- FSTAB ---\n{out}"
    ret, out, _ = run_cmd("lsblk -f")
    if ret == 0:
        fp = os.path.join(evid_dir, "lsblk.txt")
        save_file(fp, out)
        ev_files.append(fp)
        datos_tecnicos += f"\n--- LSBLK ---\n{out}"
    ret, out, _ = run_cmd("find / -perm -4000 -type f 2>/dev/null", use_sudo=True, timeout=120)
    if ret == 0:
        fp = os.path.join(evid_dir, "suid.txt")
        save_file(fp, out)
        ev_files.append(fp)
        datos_tecnicos += f"\n--- SUID ---\n{out[:10000]}"
        suid_count = len([l for l in out.strip().split("\n") if l.strip()])
        hallazgos.append(f"SUID: {suid_count} archivos.")
    ret, out, _ = run_cmd("find / -perm -2000 -type f 2>/dev/null", use_sudo=True, timeout=120)
    if ret == 0:
        fp = os.path.join(evid_dir, "sgid.txt")
        save_file(fp, out)
        ev_files.append(fp)
        datos_tecnicos += f"\n--- SGID ---\n{out[:5000]}"
    ret, out, _ = run_cmd("find / -xdev -type d -perm -0002 2>/dev/null", use_sudo=True, timeout=120)
    if ret == 0:
        fp = os.path.join(evid_dir, "world_writable.txt")
        save_file(fp, out)
        ev_files.append(fp)
        datos_tecnicos += f"\n--- WORLD WRITABLE ---\n{out[:10000]}"
        hallazgos.append("World-writable dirs identificados.")
    ret, out, _ = run_cmd(r"find / -xdev \( -nouser -o -nogroup \) 2>/dev/null", use_sudo=True, timeout=120)
    if ret == 0:
        fp = os.path.join(evid_dir, "orphan.txt")
        save_file(fp, out)
        ev_files.append(fp)
        datos_tecnicos += f"\n--- ORPHAN ---\n{out[:5000]}"
        if out.strip():
            hallazgos.append("Archivos sin propietario detectados.")
    cumpl = "Cumple" if len(ev_files) >= 4 else "Parcial"
    sev = "Baja" if cumpl == "Cumple" else "Media"
    rec = ("Revisar permisos especiales. Mantener minimo privilegio."
           if cumpl == "Cumple"
           else "Implementar hardening de permisos. Eliminar SUID/SGID innecesarios.")
    return generate_iso_report(
        next_report_id("FS"), "A.8.1.2, A.8.3.2", "Sistema de archivos",
        "Revision de filesystem, permisos especiales y propiedad de activos.",
        "\n".join(hallazgos), ev_files, datos_tecnicos, cumpl, sev, rec,
        ["ISO/IEC 27001:2022 A.8.1.2", "ISO/IEC 27002:2022 5.9"]
    )


def linux_packages():
    evid_dir = ensure_dir(os.path.join(audit_data["output_dir"], "evidencias", "08_software"))
    hallazgos, ev_files, datos_tecnicos = [], [], ""

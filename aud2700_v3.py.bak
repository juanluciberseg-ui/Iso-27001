        if ret == 0:
            fp = os.path.join(evid_dir, "netstat.txt")
            save_file(fp, out)
            ev_files.append(fp)
            datos_tecnicos += f"\n--- NETSTAT ---\n{out[:15000]}"
    if check_tool("iptables"):
        ret, out, _ = run_cmd("iptables -L -n -v --line-numbers", use_sudo=True)
        if ret == 0:
            fp = os.path.join(evid_dir, "iptables.txt")

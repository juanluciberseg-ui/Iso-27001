            ev_files.append(fp)
            datos_tecnicos += f"\n--- {label.upper()} ---\n{out[:20000]}"
            hallazgos.append(f"{label} recopilado.")
    ret, out, _ = run_cmd('tasklist /v')
    if ret == 0:
        fp = os.path.join(evid_dir, "tasklist.txt")
        save_file(fp, out)
        ev_files.append(fp)
        datos_tecnicos += f"\n--- TASKLIST ---\n{out[:15000]}"
    cumpl = "Cumple" if len(ev_files) >= 3 else "Parcial"
    sev = "Baja" if cumpl == "Cumple" else "Media"
    rec = ("Mantener inventario. Deshabilitar servicios innecesarios."
           if cumpl == "Cumple"
           else "Documentar servicios. Implementar hardening y minimizacion.")
    return generate_iso_report(
        next_report_id("PROC"), "A.12.4.1, A.8.1.2", "Servicios y procesos Windows",
        "Revision de servicios, procesos y tareas programadas.",
        "\n".join(hallazgos), ev_files, datos_tecnicos, cumpl, sev, rec,
        ["ISO/IEC 27001:2022 A.12.4.1", "ISO/IEC 27002:2022 8.8"]
    )



    if ret == 0:
        datos_tecnicos += f"\n--- KERNEL ---\n{out}"
        hallazgos.append(f"Kernel: {out.strip()}.")
    ret, out, _ = run_cmd("lsb_release -a")
    if ret == 0:
        datos_tecnicos += f"\n--- OS ---\n{out}"
    ret, out, _ = run_cmd("env")
    if ret == 0:
        fp = os.path.join(evid_dir, "env.txt")
        save_file(fp, out)
        ev_files.append(fp)
        datos_tecnicos += f"\n--- ENV ---\n{out[:5000]}"
    cumpl = "Cumple" if len(ev_files) >= 2 else "Parcial"
    sev = "Baja" if cumpl == "Cumple" else "Media"
    rec = ("Mantener inventario. Aplicar parches periodicamente."
           if cumpl == "Cumple"
           else "Implementar gestion de parches e inventario de software autorizado.")
    return generate_iso_report(
        next_report_id("SW"), "A.8.1.1, A.8.8", "Software y parches",
        "Inventario de software y version del sistema operativo.",
        "\n".join(hallazgos), ev_files, datos_tecnicos, cumpl, sev, rec,
        ["ISO/IEC 27001:2022 A.8.1.1", "ISO/IEC 27002:2022 8.8"]
    )

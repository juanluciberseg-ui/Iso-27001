# =============================================================================
# RECOPILAR TODO
# =============================================================================
def collect_all():
    global REPORT_COUNTER
    REPORT_COUNTER = 0   # Reiniciar contador al inicio de cada recopilación completa
    is_linux = (REMOTE_OS == "linux") if REMOTE_MODE else (platform.system() != "Windows")
    all_results = []
    print(color("\n[*] INICIANDO RECOPILACION COMPLETA...", C.H))
    if not audit_data["output_dir"]:
        print(color("[!] Primero ejecute Opcion 1 para configurar datos de auditoria.", C.F))
        safe_input("Presione ENTER...")
        return
    try:
        if is_linux:
            tests = [
                ("Logs de sistema", linux_system_logs),
                ("Autenticacion", linux_auth_logs),
                ("Usuarios", linux_user_info),
                ("Red", linux_network),
                ("Framework auditoria", linux_audit_framework),
                ("Procesos y servicios", linux_processes_services),
                ("Filesystem", linux_filesystem),
                ("Software", linux_packages),
            ]
        else:
            tests = [
                ("Eventos Windows", win_event_logs),
                ("Seguridad Windows", win_security),
                ("Red Windows", win_network),
                ("Servicios y procesos", win_services_processes),
                ("Sistema Windows", win_system_info),
            ]

        for test_name, test_func in tests:
            try:
                print(color(f"\n  [>>] Ejecutando: {test_name}", C.B))
                result = test_func()
                if result:
                    all_results.append(result)
            except Exception as e:
                print(color(f"  [!] Error en {test_name}: {e}", C.F))

        summary = f"""
{'='*80}
RESUMEN DE AUDITORIA ISO 27001
{'='*80}
ID:           {audit_data['id_auditoria']}
Organizacion: {audit_data['organizacion']}
Auditor:      {audit_data['auditor']}
Fecha:        {audit_data['fecha_auditoria']}
Sistema:      {audit_data['sistema_operativo']}
Hostname:     {audit_data['hostname']}
{'='*80}
Informes generados: {len(all_results)}
{'='*80}
"""
        for r in all_results:
            if r:
                summary += f"  - {os.path.basename(r[0])}\n"
        sum_path = os.path.join(audit_data["output_dir"], "RESUMEN_AUDITORIA.txt")
        save_file(sum_path, summary)

        evid_zip = os.path.join(audit_data["output_dir"], "export", "evidencias_completas.txt")
        with open(evid_zip, 'w', encoding='utf-8') as f:
            f.write(summary + "\n")
            for root, dirs, files in os.walk(os.path.join(audit_data["output_dir"], "evidencias")):
                for file in files:
                    f.write(f"\n--- {file} ---\n")
                    try:
                        with open(os.path.join(root, file), 'r', encoding='utf-8', errors='ignore') as ef:
                            f.write(ef.read()[:5000] + "\n")
                    except Exception:
                        pass

        print(color(f"\n[+] COMPLETADO: {len(all_results)} informes", C.G))
        print(color(f"[+] Directorio: {audit_data['output_dir']}", C.G))
        print(color(f"[+] Resumen: {sum_path}", C.G))
    except (EOFError, KeyboardInterrupt):
        print(CTRL_Z_MSG)
        return


# =============================================================================
# ANALISIS CON IA
# =============================================================================
def analyze_with_ai():
    print(color("\n[*] GENERANDO PROMPT PARA ANALISIS CON IA...", C.H))
    if not audit_data["output_dir"]:
        print(color("[!] Primero ejecute Opcion 1.", C.F))
        safe_input("Presione ENTER...")
        return

    informes_dir = os.path.join(audit_data["output_dir"], "informes")
    if not os.path.exists(informes_dir):
        print(color("[!] No hay informes generados. Ejecute recopilacion primero.", C.F))
        safe_input("Presione ENTER...")
        return

    all_reports = []
    for f in sorted(os.listdir(informes_dir)):
        if f.endswith('.json'):
            try:
                with open(os.path.join(informes_dir, f), 'r', encoding='utf-8') as jf:
                    all_reports.append(json.load(jf))
            except Exception:
                pass

    if not all_reports:
        print(color("[!] No se encontraron informes JSON.", C.F))
        safe_input("Presione ENTER...")
        return

    prompt = f"""ACTUA COMO AUDITOR ISO 27001 SENIOR. ANALIZA LOS SIGUIENTES INFORMES DE AUDITORIA Y GENERA:

1. RESUMEN EJECUTIVO (max 1 pagina)
2. MAPA DE RIESGOS por control ISO 27001
3. NO CONFORMIDADES identificadas con severidad
4. RECOMENDACIONES PRIORITARIAS con roadmap
5. PUNTUACION DE MADUREZ (1-5) por dominio

DATOS DE LA AUDITORIA:
- Organizacion: {audit_data['organizacion']}
- Alcance: {audit_data['alcance']}
- Auditor: {audit_data['auditor']}
- Fecha: {audit_data['fecha_auditoria']}
- Sistema: {audit_data['sistema_operativo']}
- IP: {audit_data['ip_objetivo']}
- Dominio: {audit_data['dominio']}

INFORMES RECOPILADOS ({len(all_reports)}):
"""
    for r in all_reports:
        prompt += f"\n--- {r.get('id_informe','N/A')} | Control: {r.get('control_iso','N/A')} ---\n"
        prompt += f"Titulo: {r.get('titulo_prueba','N/A')}\n"
        prompt += f"Cumplimiento: {r.get('nivel_cumplimiento','N/A')}\n"
        prompt += f"Severidad: {r.get('severidad','N/A')}\n"
        prompt += f"Hallazgos: {r.get('hallazgos','N/A')[:500]}\n"
        prompt += f"Recomendaciones: {r.get('recomendaciones','N/A')[:500]}\n"

    prompt += """
INSTRUCCIONES:
- Usa lenguaje tecnico pero comprensible para direccion
- Cita controles ISO 27001:2022 especificos
- Incluye metricas cuantitativas donde sea posible
- Formato: Markdown con tablas y listas
"""

    ai_path = os.path.join(audit_data["output_dir"], "export", "PROMPT_ANALISIS_IA.txt")
    save_file(ai_path, prompt)

    print(color(f"\n[+] Prompt para IA generado: {ai_path}", C.G))
    print(color("[*] Copie el contenido de este archivo y peguelo en ChatGPT/Claude/etc.", C.C))
    print(color("[*] El prompt incluye todos los informes recopilados.", C.C))
    safe_input("\nPresione ENTER...")


# =============================================================================
# EXPORTAR A PDF
# =============================================================================
def export_to_pdf():
    print(color("\n[*] EXPORTANDO A PDF...", C.H))
    if not audit_data["output_dir"]:
        print(color("[!] Primero ejecute Opcion 1.", C.F))
        safe_input("Presione ENTER...")
        return

    informes_dir = os.path.join(audit_data["output_dir"], "informes")
    if not os.path.exists(informes_dir):
        print(color("[!] No hay informes para exportar.", C.F))
        safe_input("Presione ENTER...")
        return

    pdf_success = False

    # Intento 1: WeasyPrint
    try:
        from weasyprint import HTML, CSS
        print(color("[*] Usando WeasyPrint...", C.C))

        html_content = f"""<!DOCTYPE html>
<html><head><meta charset="utf-8">
<title>Auditoria ISO 27001</title>
<style>
body {{ font-family: Arial, sans-serif; margin: 40px; line-height: 1.6; }}
h1 {{ color: #1a5276; border-bottom: 3px solid #1a5276; padding-bottom: 10px; }}
h2 {{ color: #2874a6; margin-top: 30px; border-left: 4px solid #2874a6; padding-left: 10px; }}
h3 {{ color: #5499c7; }}
pre {{ background: #f4f4f4; padding: 15px; border-radius: 5px; overflow-x: auto; font-size: 9px; }}
table {{ width: 100%; border-collapse: collapse; margin: 15px 0; }}
th, td {{ border: 1px solid #ddd; padding: 8px; text-align: left; font-size: 11px; }}
th {{ background: #1a5276; color: white; }}
.cumple {{ color: green; font-weight: bold; }}
.parcial {{ color: orange; font-weight: bold; }}
.no-cumple {{ color: red; font-weight: bold; }}
.header {{ background: #1a5276; color: white; padding: 20px; margin: -40px -40px 20px -40px; }}
.footer {{ margin-top: 40px; font-size: 10px; color: #666; border-top: 1px solid #ccc; padding-top: 10px; }}
</style></head><body>
<div class="header">
<h1>Informe de Auditoria ISO/IEC 27001:2022</h1>
<p><strong>Organizacion:</strong> {audit_data['organizacion']} | 
<strong>Auditor:</strong> {audit_data['auditor']} | 
<strong>Fecha:</strong> {audit_data['fecha_auditoria']}</p>
<p><strong>ID:</strong> {audit_data['id_auditoria']} | 
<strong>Sistema:</strong> {audit_data['sistema_operativo']} | 
<strong>Hostname:</strong> {audit_data['hostname']}</p>
</div>
"""

        for f in sorted(os.listdir(informes_dir)):
            if f.endswith('.json'):
                try:
                    with open(os.path.join(informes_dir, f), 'r', encoding='utf-8') as jf:
                        r = json.load(jf)
                    cumpl_class = "cumple" if r.get('nivel_cumplimiento') == "Cumple" else (
                        "parcial" if r.get('nivel_cumplimiento') == "Parcial" else "no-cumple"
                    )
                    html_content += f"""
<h2>{r.get('id_informe','N/A')} - {r.get('titulo_prueba','N/A')}</h2>
<table>
<tr><th>Control ISO</th><td>{r.get('control_iso','N/A')}</td></tr>
<tr><th>Cumplimiento</th><td class="{cumpl_class}">{r.get('nivel_cumplimiento','N/A')}</td></tr>
<tr><th>Severidad</th><td>{r.get('severidad','N/A')}</td></tr>
<tr><th>Fecha</th><td>{r.get('fecha_hora','N/A')}</td></tr>
</table>
<h3>Descripcion</h3>
<p>{r.get('descripcion','N/A').replace(chr(10),'<br>')}</p>
<h3>Hallazgos</h3>
<pre>{r.get('hallazgos','N/A')}</pre>
<h3>Recomendaciones</h3>
<p>{r.get('recomendaciones','N/A').replace(chr(10),'<br>')}</p>
<h3>Datos Tecnicos (resumen)</h3>
<pre>{r.get('datos_tecnicos','N/A')[:3000]}...</pre>
<p><small>Hash: {r.get('hash_integridad','N/A')}</small></p>
<hr>
"""
                except Exception:
                    pass

        html_content += f"""
<div class="footer">
Generado por ISO27001 Auditor v{SCRIPT_VERSION} | 
Hash de integridad verificado | 
Confidencial - Solo para uso del auditor autorizado
</div></body></html>"""

        pdf_path = os.path.join(audit_data["output_dir"], "export", "INFORME_AUDITORIA_ISO27001.pdf")
        HTML(string=html_content).write_pdf(pdf_path)
        print(color(f"[+] PDF generado: {pdf_path}", C.G))
        pdf_success = True
    except ImportError:
        pass
    except Exception as e:
        print(color(f"[!] Error con WeasyPrint: {e}", C.F))

    # Intento 2: ReportLab
    if not pdf_success:
        try:
            from reportlab.lib.pagesizes import A4
            from reportlab.platypus import (
                SimpleDocTemplate, Paragraph, Spacer, Preformatted, Table, TableStyle
            )
            from reportlab.lib.styles import getSampleStyleSheet
            from reportlab.lib import colors

            print(color("[*] Usando ReportLab...", C.C))
            pdf_path = os.path.join(audit_data["output_dir"], "export", "INFORME_AUDITORIA_ISO27001.pdf")
            doc = SimpleDocTemplate(pdf_path, pagesize=A4)
            styles = getSampleStyleSheet()
            story = []

            story.append(Paragraph("<b>Informe de Auditoria ISO/IEC 27001:2022</b>", styles['Title']))
            story.append(Paragraph(f"Organizacion: {audit_data['organizacion']}", styles['Normal']))
            story.append(Paragraph(
                f"Auditor: {audit_data['auditor']} | Fecha: {audit_data['fecha_auditoria']}",
                styles['Normal']
            ))
            story.append(Spacer(1, 20))

            for f in sorted(os.listdir(informes_dir)):
                if f.endswith('.json'):
                    try:
                        with open(os.path.join(informes_dir, f), 'r', encoding='utf-8') as jf:
                            r = json.load(jf)
                        story.append(Paragraph(f"<b>{r.get('id_informe','N/A')}</b>", styles['Heading2']))
                        story.append(Paragraph(f"Control: {r.get('control_iso','N/A')}", styles['Normal']))
                        story.append(Paragraph(
                            f"Cumplimiento: {r.get('nivel_cumplimiento','N/A')} | "
                            f"Severidad: {r.get('severidad','N/A')}",
                            styles['Normal']
                        ))
                        story.append(Paragraph("Hallazgos:", styles['Heading3']))
                        story.append(Preformatted(r.get('hallazgos','N/A')[:2000], styles['Code']))
                        story.append(Paragraph("Recomendaciones:", styles['Heading3']))
                        story.append(Paragraph(r.get('recomendaciones','N/A')[:2000], styles['Normal']))
                        story.append(Spacer(1, 15))
                    except Exception:
                        pass

            doc.build(story)
            print(color(f"[+] PDF generado: {pdf_path}", C.G))
            pdf_success = True
        except ImportError:
            pass
        except Exception as e:
            print(color(f"[!] Error con ReportLab: {e}", C.F))

    # Fallback: HTML
    if not pdf_success:
        print(color("[!] No se encontro libreria PDF. Generando HTML...", C.W))
        html_path = os.path.join(audit_data["output_dir"], "export", "INFORME_AUDITORIA_ISO27001.html")

        html = f"""<!DOCTYPE html>
<html><head><meta charset="utf-8"><title>Auditoria ISO 27001</title>
<style>
body {{ font-family: Arial, sans-serif; margin: 40px; }}
h1 {{ color: #1a5276; }}
h2 {{ color: #2874a6; border-left: 4px solid #2874a6; padding-left: 10px; }}
pre {{ background: #f4f4f4; padding: 15px; border-radius: 5px; }}
table {{ width: 100%; border-collapse: collapse; }}
th, td {{ border: 1px solid #ddd; padding: 8px; }}
th {{ background: #1a5276; color: white; }}
</style></head><body>
<h1>Informe de Auditoria ISO/IEC 27001:2022</h1>
<p><b>Organizacion:</b> {audit_data['organizacion']} | 
<b>Auditor:</b> {audit_data['auditor']} | 
<b>Fecha:</b> {audit_data['fecha_auditoria']}</p>
"""
        for f in sorted(os.listdir(informes_dir)):
            if f.endswith('.json'):
                try:
                    with open(os.path.join(informes_dir, f), 'r', encoding='utf-8') as jf:
                        r = json.load(jf)
                    html += f"""
<h2>{r.get('id_informe','N/A')} - {r.get('titulo_prueba','N/A')}</h2>
<table>
<tr><th>Control</th><td>{r.get('control_iso','N/A')}</td>
<th>Cumplimiento</th><td>{r.get('nivel_cumplimiento','N/A')}</td></tr>
<tr><th>Severidad</th><td>{r.get('severidad','N/A')}</td>
<th>Fecha</th><td>{r.get('fecha_hora','N/A')}</td></tr>
</table>
<h3>Hallazgos</h3><pre>{r.get('hallazgos','N/A')}</pre>
<h3>Recomendaciones</h3>
<p>{r.get('recomendaciones','N/A').replace(chr(10),'<br>')}</p>
<p><small>Hash: {r.get('hash_integridad','N/A')}</small></p>
<hr>"""
                except Exception:
                    pass
        html += "</body></html>"
        save_file(html_path, html)
        print(color(f"[+] HTML generado (abra en navegador e imprima a PDF): {html_path}", C.G))
        print(color("[*] Instale WeasyPrint (pip install weasyprint) o ReportLab para PDF nativo.", C.C))

    safe_input("\nPresione ENTER...")


# =============================================================================
# MENU PRINCIPAL
# =============================================================================
def show_menu():
    clear()
    banner()
    show_audit_info()
    print(color("--- MENU PRINCIPAL ---", C.H))
    print("  [1] Configurar datos de auditoria")
    print("  [2] Recopilar TODAS las evidencias")
    print("  [3] Logs de Sistema / Eventos")
    print("  [4] Logs de Autenticacion / Seguridad")
    print("  [5] Usuarios y Grupos")
    print("  [6] Red y Firewall")
    print("  [7] Framework de Auditoria")
    print("  [8] Procesos y Servicios")
    print("  [9] Sistema de Archivos / Software")
    print("  [A] Analizar informes con IA (genera prompt)")
    print("  [P] Exportar informes a PDF")
    print("  [S] Salir")
    print()


def main():
    check_privileges()
    verify_tools_at_startup()

    while True:
        try:
            show_menu()
            choice = safe_input("Seleccione opcion: ").strip().upper()
            is_linux = (REMOTE_OS == "linux") if REMOTE_MODE else (platform.system() != "Windows")

            if choice == "1":
                collect_audit_data()
            elif choice == "2":
                collect_all()
            elif choice == "3":
                if not audit_data["output_dir"]:
                    print(color("[!] Opcion 1 primero.", C.F))
                    safe_input("ENTER...")
                    continue
                if is_linux:
                    linux_system_logs()
                else:
                    win_event_logs()
                safe_input("\nENTER...")
            elif choice == "4":
                if not audit_data["output_dir"]:
                    print(color("[!] Opcion 1 primero.", C.F))
                    safe_input("ENTER...")
                    continue
                if is_linux:
                    linux_auth_logs()
                else:
                    win_security()
                safe_input("\nENTER...")
            elif choice == "5":
                if not audit_data["output_dir"]:
                    print(color("[!] Opcion 1 primero.", C.F))
                    safe_input("ENTER...")
                    continue
                if is_linux:
                    linux_user_info()
                else:
                    print(color("[!] Usuarios en Windows: use opcion 4 (Seguridad).", C.W))
                safe_input("ENTER...")
            elif choice == "6":
                if not audit_data["output_dir"]:
                    print(color("[!] Opcion 1 primero.", C.F))
                    safe_input("ENTER...")
                    continue
                if is_linux:
                    linux_network()
                else:
                    win_network()
                safe_input("\nENTER...")
            elif choice == "7":
                if not audit_data["output_dir"]:
                    print(color("[!] Opcion 1 primero.", C.F))
                    safe_input("ENTER...")
                    continue
                if is_linux:
                    linux_audit_framework()
                else:
                    print(color("[!] Framework audit nativo no disponible en Windows.", C.W))
                safe_input("ENTER...")
            elif choice == "8":
                if not audit_data["output_dir"]:
                    print(color("[!] Opcion 1 primero.", C.F))
                    safe_input("ENTER...")
                    continue
                if is_linux:
                    linux_processes_services()
                else:
                    win_services_processes()
                safe_input("\nENTER...")
            elif choice == "9":
                if not audit_data["output_dir"]:
                    print(color("[!] Opcion 1 primero.", C.F))
                    safe_input("ENTER...")
                    continue
                if is_linux:
                    linux_filesystem()
                    linux_packages()
                else:
                    win_system_info()
                safe_input("\nENTER...")
            elif choice == "A":
                analyze_with_ai()
            elif choice == "P":
                export_to_pdf()
            elif choice == "S":
                if REMOTE_MODE:
                    disconnect_remote_target()
                print(color("\n[+] Saliendo...", C.G))
                break
            else:
                print(color("[!] Opcion invalida", C.F))
                safe_input("ENTER...")
        except (EOFError, KeyboardInterrupt):
            continue


if __name__ == "__main__":
    main()
    
def win_event_logs():
    evid_dir = ensure_dir(os.path.join(audit_data["output_dir"], "evidencias", "01_eventos"))
    hallazgos, ev_files, datos_tecnicos = [], [], ""
    print(color("  [*] Eventos Windows (A.12.4.1)...", C.C))
    channels = ["Security", "System", "Application", "Setup", "ForwardedEvents",
                "Microsoft-Windows-PowerShell/Operational"]
    for ch in channels:
        ps = (f'Get-WinEvent -LogName "{ch}" -MaxEvents 2000 '
              f'-ErrorAction SilentlyContinue | Format-List *')
        ret, out, _ = run_cmd(f'powershell -Command "{ps}"', timeout=120)
        if ret == 0 and out.strip():
            safe_ch = ch.replace("/", "_")
            fp = os.path.join(evid_dir, f"{safe_ch}.txt")
            save_file(fp, out)
            ev_files.append(fp)
            datos_tecnicos += f"\n--- {ch} ---\n{out[:30000]}"
            hallazgos.append(f"Canal {ch} recopilado.")
    ret, out, _ = run_cmd('wevtutil el')
    if ret == 0:
        fp = os.path.join(evid_dir, "channels.txt")
        save_file(fp, out)
        ev_files.append(fp)
        datos_tecnicos += f"\n--- CHANNELS ---\n{out[:10000]}"
        hallazgos.append("Canales de eventos listados.")
    cumpl = "Cumple" if len(ev_files) >= 3 else "Parcial"
    sev = "Baja" if cumpl == "Cumple" else "Media"
    rec = ("Mantener retencion de logs. Verificar integridad."
           if cumpl == "Cumple"
           else "Configurar retencion minima 12 meses. Centralizar en SIEM.")
    return generate_iso_report(
        next_report_id("EVT"), "A.12.4.1", "Registros de eventos Windows",
        "Verificacion de logs de eventos de Windows.",
        "\n".join(hallazgos), ev_files, datos_tecnicos, cumpl, sev, rec,
        ["ISO/IEC 27001:2022 A.12.4.1", "ISO/IEC 27002:2022 8.15"]
    )


def win_security():
    evid_dir = ensure_dir(os.path.join(audit_data["output_dir"], "evidencias", "02_seguridad"))
    hallazgos, ev_files, datos_tecnicos = [], [], ""
    print(color("  [*] Seguridad Windows (A.9.4)...", C.C))
    ps_cmds = [
        ('Get-LocalUser | Select-Object * | Format-List', "users.txt", "Usuarios locales"),
        ('Get-LocalGroup | Select-Object * | Format-List', "groups.txt", "Grupos locales"),
        ('Get-LocalGroupMember -Group "Administrators" | Format-List', "admins.txt", "Grupo Administrators"),
    ]
    for ps, fname, label in ps_cmds:
        ret, out, _ = run_cmd(f'powershell -Command "{ps}"')
        if ret == 0:
            fp = os.path.join(evid_dir, fname)
            save_file(fp, out)
            ev_files.append(fp)
            datos_tecnicos += f"\n--- {label.upper()} ---\n{out[:15000]}"
            hallazgos.append(f"{label} recopilado.")
    ret, out, _ = run_cmd('net accounts')
    if ret == 0:
        fp = os.path.join(evid_dir, "password_policy.txt")
        save_file(fp, out)
        ev_files.append(fp)
        datos_tecnicos += f"\n--- PASSWORD POLICY ---\n{out}"
        hallazgos.append("Politica de contrasenas recopilada.")
    ret, out, _ = run_cmd('secedit /export /cfg "%TEMP%\\secpol.cfg" && type "%TEMP%\\secpol.cfg"')
    if ret == 0:
        fp = os.path.join(evid_dir, "secpol.txt")
        save_file(fp, out)
        ev_files.append(fp)
        datos_tecnicos += f"\n--- SECPOL ---\n{out[:20000]}"
        hallazgos.append("Politicas de seguridad exportadas.")
    cumpl = "Cumple" if len(ev_files) >= 3 else "Parcial"
    sev = "Baja" if cumpl == "Cumple" else "Alta"
    rec = ("Verificar politicas de contrasena. Revisar membresia de grupos privilegiados."
           if cumpl == "Cumple"
           else "Implementar politicas de contrasena robustas. Restringir acceso administrativo.")
    return generate_iso_report(
        next_report_id("SEC"), "A.9.4.2, A.9.4.3", "Seguridad de acceso Windows",
        "Revision de usuarios, grupos y politicas de seguridad.",
        "\n".join(hallazgos), ev_files, datos_tecnicos, cumpl, sev, rec,
        ["ISO/IEC 27001:2022 A.9.4.2", "ISO/IEC 27002:2022 5.17"]
    )


def win_network():
    evid_dir = ensure_dir(os.path.join(audit_data["output_dir"], "evidencias", "03_red"))
    hallazgos, ev_files, datos_tecnicos = [], [], ""
    print(color("  [*] Red Windows (A.13.1)...", C.C))
    for cmd, fname, label in [
        ('ipconfig /all', "ipconfig.txt", "IPCONFIG"),
        ('route print', "route.txt", "ROUTE"),
        ('netstat -anob', "netstat.txt", "NETSTAT"),
        ('arp -a', "arp.txt", "ARP")
    ]:
        ret, out, _ = run_cmd(cmd)
        if ret == 0:
            fp = os.path.join(evid_dir, fname)
            save_file(fp, out)
            ev_files.append(fp)
            datos_tecnicos += f"\n--- {label} ---\n{out[:20000]}"
            hallazgos.append(f"{label} recopilado.")
    ps = ('Get-NetFirewallRule | Where-Object {$_.Enabled -eq "True"} '
          '| Format-Table -AutoSize')
    ret, out, _ = run_cmd(f'powershell -Command "{ps}"', timeout=120)
    if ret == 0:
        fp = os.path.join(evid_dir, "firewall.txt")
        save_file(fp, out)
        ev_files.append(fp)
        datos_tecnicos += f"\n--- FIREWALL ---\n{out[:30000]}"
        hallazgos.append("Reglas de firewall recopiladas.")
    ret, out, _ = run_cmd('netsh advfirewall show allprofiles')
    if ret == 0:
        fp = os.path.join(evid_dir, "firewall_profiles.txt")
        save_file(fp, out)
        ev_files.append(fp)
        datos_tecnicos += f"\n--- FIREWALL PROFILES ---\n{out}"
    cumpl = "Cumple" if len(ev_files) >= 3 else "Parcial"
    sev = "Baja" if cumpl == "Cumple" else "Alta"
    rec = ("Documentar topologia. Segmentar red. Controlar servicios expuestos."
           if cumpl == "Cumple"
           else "Implementar firewall de host. Documentar y segmentar la red.")
    return generate_iso_report(
        next_report_id("NET"), "A.13.1.1, A.13.1.2", "Controles de red Windows",
        "Revision de configuracion de red, firewall y servicios.",
        "\n".join(hallazgos), ev_files, datos_tecnicos, cumpl, sev, rec,
        ["ISO/IEC 27001:2022 A.13.1.1", "ISO/IEC 27002:2022 8.20"]
    )


def win_services_processes():
    evid_dir = ensure_dir(os.path.join(audit_data["output_dir"], "evidencias", "04_servicios"))
    hallazgos, ev_files, datos_tecnicos = [], [], ""

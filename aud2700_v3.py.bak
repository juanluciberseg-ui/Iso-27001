#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
================================================================================
  AUDITORIA ISO/IEC 27001:2022 - RECOPILACION Y GENERACION DE EVIDENCIAS
  Script multiplataforma para Kali Linux y Windows
================================================================================
  Recopila logs, genera informes estructurados conforme a ISO 27001,
  permite analisis con IA y exportacion a PDF.

  Uso:
    Linux (Kali):   sudo python3 iso27001_auditor.py
    Windows:        python iso27001_auditor.py  (como Administrador)
"""

import os
import sys
import platform
import subprocess
import shutil
import json
import datetime
import signal
import getpass
import re
import hashlib
from pathlib import Path

# =============================================================================
# CONFIGURACION GLOBAL
# =============================================================================
SCRIPT_VERSION = "3.1"
CTRL_Z_MSG = "\n[+] Volviendo al menu principal..."

SUDO_CACHED = False
IS_ADMIN = False
REPORT_COUNTER = 0

# --- Estado de auditoria REMOTA (SSH para Linux, WinRM para Windows) ---
REMOTE_MODE = False
REMOTE_OS = None          # "linux" | "windows"
REMOTE_HOST = ""
REMOTE_PORT = None
REMOTE_USER = ""
REMOTE_PASS = ""          # solo en memoria durante la sesion, nunca se escribe a disco
SSH_CLIENT = None
WINRM_SESSION = None
WINRM_TRANSPORT = "ntlm"  # usar "basic" si el objetivo tiene WinRM con HTTPS/basic auth

audit_data = {
    "organizacion": "", "alcance": "", "auditor": "", "fecha_auditoria": "",
    "ip_objetivo": "", "dominio": "", "contacto": "", "ubicacion": "",
    "norma": "ISO/IEC 27001:2022", "hostname": "", "sistema_operativo": "",
    "output_dir": "", "id_auditoria": ""
}


class C:
    H = '\033[95m' if os.name != 'nt' else ''
    B = '\033[94m' if os.name != 'nt' else ''
    C = '\033[96m' if os.name != 'nt' else ''
    G = '\033[92m' if os.name != 'nt' else ''
    W = '\033[93m' if os.name != 'nt' else ''
    F = '\033[91m' if os.name != 'nt' else ''
    E = '\033[0m' if os.name != 'nt' else ''
    BD = '\033[1m' if os.name != 'nt' else ''


def color(t, c):
    return f"{c}{t}{C.E}"


def _import_paramiko():
    try:
        import paramiko
        return paramiko
    except ImportError:
        print(color("  [!] Falta el modulo 'paramiko' para SSH remoto.", C.F))
        print(color("      Instalelo con: pip install paramiko --break-system-packages", C.W))
        return None


def _import_winrm():
    try:
        import winrm
        return winrm
    except ImportError:
        print(color("  [!] Falta el modulo 'pywinrm' para WinRM remoto.", C.F))
        print(color("      Instalelo con: pip install pywinrm --break-system-packages", C.W))
        return None


def sig_handler(signum, frame):
    print(CTRL_Z_MSG)
    raise KeyboardInterrupt("SIGTSTP")


if hasattr(signal, 'SIGTSTP'):
    signal.signal(signal.SIGTSTP, sig_handler)
if hasattr(signal, 'SIGINT'):
    signal.signal(signal.SIGINT, sig_handler)


def clear():
    os.system('cls' if os.name == 'nt' else 'clear')


def banner():
    print(f"""
{C.C}╔══════════════════════════════════════════════════════════════════════════════╗
║         ISO/IEC 27001:2022 - RECOPILACION DE EVIDENCIAS DE AUDITORIA       ║
║                    Version {SCRIPT_VERSION} | Multiplataforma | Ctrl+Z = Menu            ║
╚══════════════════════════════════════════════════════════════════════════════╝{C.E}
""")


def safe_input(prompt, default=""):
    try:
        r = input(prompt)
        return r.strip() if r.strip() else default
    except (EOFError, KeyboardInterrupt):
        print(CTRL_Z_MSG)
        raise


def run_cmd(cmd, shell=True, capture=True, timeout=120, use_sudo=False):
    global SUDO_CACHED
    if REMOTE_MODE:
        return run_cmd_remote(cmd, timeout=timeout, use_sudo=use_sudo)
    if use_sudo and SUDO_CACHED and not IS_ADMIN and os.name != 'nt':
        cmd = f"sudo {cmd}"
    try:
        if capture:
            r = subprocess.run(cmd, shell=shell, capture_output=True, text=True,
                             timeout=timeout, encoding='utf-8', errors='ignore')
            return r.returncode, r.stdout, r.stderr
        else:
            r = subprocess.run(cmd, shell=shell, timeout=timeout)
            return r.returncode, "", ""
    except subprocess.TimeoutExpired:
        return -1, "", "Timeout"
    except Exception as e:
        return -1, "", str(e)


def run_cmd_remote(cmd, timeout=120, use_sudo=False):
    """Despacha la ejecucion de un comando hacia el equipo objetivo remoto."""
    if REMOTE_OS == "linux":
        rc, out, err = _run_cmd_ssh(cmd, timeout=timeout, use_sudo=use_sudo)
    elif REMOTE_OS == "windows":
        rc, out, err = _run_cmd_winrm(cmd, timeout=timeout)
    else:
        return -1, "", "Modo remoto activo pero sin SO objetivo configurado"
    if rc != 0:
        detalle = (err or out or "").strip().replace("\n", " ")[:200]
        print(color(f"    [!] Fallo remoto (rc={rc}): {cmd[:70]}", C.W))
        if detalle:
            print(color(f"        -> {detalle}", C.W))
    return rc, out, err


def _ssh_alive():
    if SSH_CLIENT is None:
        return False
    transport = SSH_CLIENT.get_transport()
    return transport is not None and transport.is_active()


def _reconnect_ssh_silent():
    """Reconecta por SSH usando las credenciales ya guardadas en memoria, sin volver
    a pedirle nada al usuario. Se usa cuando la sesion se cae a mitad de auditoria."""
    global SSH_CLIENT
    if not REMOTE_HOST or not REMOTE_USER:
        return False
    paramiko = _import_paramiko()
    if not paramiko:
        return False
    try:
        client = paramiko.SSHClient()
        client.set_missing_host_key_policy(paramiko.AutoAddPolicy())
        client.connect(REMOTE_HOST, port=REMOTE_PORT, username=REMOTE_USER,
                        password=REMOTE_PASS, timeout=15, banner_timeout=15, auth_timeout=15)
        SSH_CLIENT = client
        print(color(f"    [i] Sesion SSH perdida. Reconectado automaticamente a {REMOTE_HOST}.", C.C))
        return True
    except Exception as e:
        print(color(f"    [!] Reconexion SSH automatica fallo: {e}", C.F))
        return False


def _run_cmd_ssh(cmd, timeout=120, use_sudo=False):
    if not _ssh_alive():
        if not _reconnect_ssh_silent():
            return -1, "", "No hay conexion SSH activa con el objetivo (reconexion fallida)"
    try:
        return _exec_ssh_once(cmd, timeout=timeout, use_sudo=use_sudo)
    except Exception as e:
        # La sesion pudo caerse justo durante este comando: reconectar y reintentar UNA vez,
        # reutilizando las credenciales ya guardadas (sin volver a preguntar al usuario).
        if _reconnect_ssh_silent():
            try:
                return _exec_ssh_once(cmd, timeout=timeout, use_sudo=use_sudo)
            except Exception as e2:
                return -1, "", str(e2)
        return -1, "", str(e)


def _exec_ssh_once(cmd, timeout=120, use_sudo=False):
    if use_sudo:
        safe_cmd = cmd.replace("'", "'\\''")
        remote_cmd = f"sudo -S -p '' bash -c '{safe_cmd}'"
    else:
        remote_cmd = cmd
    stdin, stdout, stderr = SSH_CLIENT.exec_command(remote_cmd, timeout=timeout, get_pty=use_sudo)
    if use_sudo:
        stdin.write(REMOTE_PASS + "\n")
        stdin.flush()
    out = stdout.read().decode(errors="ignore")
    err = stderr.read().decode(errors="ignore")
    rc = stdout.channel.recv_exit_status()
    return rc, out, err


def _reconnect_winrm_silent():
    """Recrea la sesion WinRM usando las credenciales ya guardadas en memoria."""
    global WINRM_SESSION
    if not REMOTE_HOST or not REMOTE_USER:
        return False
    winrm = _import_winrm()
    if not winrm:
        return False
    try:
        endpoint = f"http://{REMOTE_HOST}:{REMOTE_PORT}/wsman"
        WINRM_SESSION = winrm.Session(endpoint, auth=(REMOTE_USER, REMOTE_PASS), transport=WINRM_TRANSPORT)
        print(color(f"    [i] Sesion WinRM renovada automaticamente con {REMOTE_HOST}.", C.C))
        return True
    except Exception as e:
        print(color(f"    [!] Renovacion WinRM automatica fallo: {e}", C.F))
        return False


def _run_cmd_winrm(cmd, timeout=120):
    if WINRM_SESSION is None:
        if not _reconnect_winrm_silent():
            return -1, "", "No hay sesion WinRM activa con el objetivo (reconexion fallida)"
    try:
        return _exec_winrm_once(cmd)
    except Exception as e:
        if _reconnect_winrm_silent():
            try:
                return _exec_winrm_once(cmd)
            except Exception as e2:
                return -1, "", str(e2)
        return -1, "", str(e)


def _exec_winrm_once(cmd):
    # Las funciones win_* ya construyen comandos como: powershell -Command "..."
    m = re.match(r'^powershell(?:\.exe)?\s+-Command\s+"(.*)"\s*$', cmd, re.DOTALL)
    if m:
        ps_script = m.group(1)
    else:
        # Comandos "planos" (tasklist, netstat, secedit, etc.) se envuelven
        # en cmd /c dentro de PowerShell para soportar operadores como &&
        escaped = cmd.replace('"', '`"')
        ps_script = f'cmd /c "{escaped}"'
    r = WINRM_SESSION.run_ps(ps_script)
    out = r.std_out.decode(errors="ignore")
    err = r.std_err.decode(errors="ignore")
    return r.status_code, out, err


def check_tool(name):
    if REMOTE_MODE:
        return check_tool_remote(name)
    return shutil.which(name) is not None


def path_exists(path):
    """Comprueba si una ruta existe: en el objetivo remoto si hay modo remoto activo,
    o en el equipo local en caso contrario. Usar SIEMPRE esta funcion (no os.path.exists)
    dentro de las funciones de recopilacion de evidencias."""
    if REMOTE_MODE and REMOTE_OS == "linux":
        ret, _, _ = run_cmd(f"test -e '{path}'", use_sudo=True)
        return ret == 0
    return os.path.exists(path)


def check_tool_remote(name):
    if REMOTE_OS == "linux":
        ret, out, _ = run_cmd(f"command -v {name}")
        return ret == 0 and out.strip() != ""
    elif REMOTE_OS == "windows":
        ret, out, _ = run_cmd(
            f'powershell -Command "Get-Command {name} -ErrorAction SilentlyContinue '
            f'| Select-Object -First 1 | Format-Table -HideTableHeaders"'
        )
        return ret == 0 and out.strip() != ""
    return False


def _prompt_remote_credentials():
    """Pide desde cero SO/host/puerto/usuario/contrasena del objetivo remoto.
    Devuelve (None, None, None, None, None) si el usuario cancela o falta un dato requerido."""
    so = safe_input("  SO del objetivo [linux/windows]: ", "linux").lower()
    so = "windows" if so.startswith("w") else "linux"
    host = safe_input("  IP/host del objetivo: ", audit_data.get("ip_objetivo", ""))
    if not host:
        print(color("  [!] IP/host requerido.", C.F))
        return None, None, None, None, None
    default_port = "22" if so == "linux" else "5985"
    port_str = safe_input(f"  Puerto [{default_port}]: ", default_port)
    try:
        port = int(port_str)
    except ValueError:
        port = int(default_port)
    user = safe_input("  Usuario administrador del objetivo: ")
    if not user:
        print(color("  [!] Usuario requerido.", C.F))
        return None, None, None, None, None
    try:
        passwd = getpass.getpass("  Contrasena (no se muestra ni se guarda en disco): ")
    except (EOFError, KeyboardInterrupt):
        print(CTRL_Z_MSG)
        return None, None, None, None, None
    return so, host, port, user, passwd


def connect_remote_target():
    """Configura y prueba la conexion contra un equipo objetivo remoto (SSH o WinRM)."""
    global REMOTE_MODE, REMOTE_OS, REMOTE_HOST, REMOTE_PORT, REMOTE_USER, REMOTE_PASS
    global SSH_CLIENT, WINRM_SESSION

    print(color("\n--- CONFIGURACION DE OBJETIVO REMOTO ---", C.H))

    # Si ya nos conectamos antes en esta misma sesion, ofrecer reutilizar esos datos
    # (incluida la contrasena, ya guardada en memoria) en vez de volver a pedirlos.
    if REMOTE_HOST and REMOTE_USER and REMOTE_OS:
        print(color(f"  [i] Datos guardados de la conexion anterior: "
                     f"{REMOTE_USER}@{REMOTE_HOST}:{REMOTE_PORT} ({REMOTE_OS})", C.C))
        reutilizar = safe_input("  Reutilizar estos datos sin volver a pedirlos? [S/n]: ", "S").upper()
        if reutilizar != "N":
            so_local, host, port, user, passwd = REMOTE_OS, REMOTE_HOST, REMOTE_PORT, REMOTE_USER, REMOTE_PASS
        else:
            so_local, host, port, user, passwd = _prompt_remote_credentials()
            if so_local is None:
                return False
    else:
        so_local, host, port, user, passwd = _prompt_remote_credentials()
        if so_local is None:
            return False

    REMOTE_OS = so_local
    print(color("  [*] Probando conexion...", C.C))

    if REMOTE_OS == "linux":
        paramiko = _import_paramiko()
        if not paramiko:
            return False
        try:
            client = paramiko.SSHClient()
            client.set_missing_host_key_policy(paramiko.AutoAddPolicy())
            client.connect(host, port=port, username=user, password=passwd,
                            timeout=15, banner_timeout=15, auth_timeout=15)
            _, stdout, _ = client.exec_command("echo OK", timeout=10)
            result = stdout.read().decode(errors="ignore").strip()
            if result != "OK":
                print(color("  [!] Conexion establecida pero respuesta inesperada del host.", C.F))
                client.close()
                return False
        except Exception as e:
            print(color(f"  [!] Error de conexion SSH: {e}", C.F))
            return False
        SSH_CLIENT = client
    else:
        winrm = _import_winrm()
        if not winrm:
            return False
        try:
            endpoint = f"http://{host}:{port}/wsman"
            session = winrm.Session(endpoint, auth=(user, passwd), transport=WINRM_TRANSPORT)
            r = session.run_cmd("hostname")
            if r.status_code != 0:
                print(color(f"  [!] WinRM respondio con error: {r.std_err.decode(errors='ignore')}", C.F))
                return False
            print(color(f"      Hostname remoto: {r.std_out.decode(errors='ignore').strip()}", C.C))

            # Deteccion de UAC remoto (LocalAccountTokenFilterPolicy): si el usuario es un
            # admin local (no la cuenta "Administrator" incorporada), Windows suele entregarle
            # un token SIN elevar en conexiones de red, y las pruebas que requieren privilegios
            # (logs Security, secedit, grupos, etc.) fallaran en silencio.
            r2 = session.run_cmd("net session")
            if r2.status_code != 0:
                print(color("\n  [!] AVISO IMPORTANTE: token administrativo NO elevado en la sesion remota.", C.W))
                print(color("      Esto es tipico de UAC remoto (LocalAccountTokenFilterPolicy=0) al usar", C.W))
                print(color("      una cuenta local de administrador que NO es la cuenta 'Administrator'", C.W))
                print(color("      integrada. Muchas pruebas (Security log, secedit, grupos...) fallaran", C.W))
                print(color("      con 'Access is denied' aunque la conexion funcione.", C.W))
                print(color("      Solucion en el OBJETIVO (PowerShell como Administrador):", C.W))
                print(color('      New-ItemProperty -Path "HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\'
                             'Policies\\System" -Name LocalAccountTokenFilterPolicy -PropertyType DWord '
                             '-Value 1 -Force', C.C))
                print(color("      Alternativa: conectar con la cuenta 'Administrator' incorporada.\n", C.W))
                cont = safe_input("      Continuar de todas formas? [s/N]: ", "N").upper()
                if cont != "S":
                    return False
        except Exception as e:
            print(color(f"  [!] Error de conexion WinRM: {e}", C.F))
            print(color("      Verifique que WinRM este habilitado en el objetivo:", C.W))
            print(color("      (ejecutar en el Windows Server objetivo) winrm quickconfig -q", C.W))
            return False
        WINRM_SESSION = session

    REMOTE_MODE = True
    REMOTE_HOST, REMOTE_PORT, REMOTE_USER, REMOTE_PASS = host, port, user, passwd
    audit_data["ip_objetivo"] = host
    audit_data["modo_auditoria"] = f"REMOTO-{REMOTE_OS.upper()}"
    print(color(f"  [+] Conexion establecida con {host}:{port} ({REMOTE_OS}).", C.G))
    return True


def disconnect_remote_target():
    global REMOTE_MODE, SSH_CLIENT, WINRM_SESSION
    if SSH_CLIENT is not None:
        try:
            SSH_CLIENT.close()
        except Exception:
            pass
    SSH_CLIENT = None
    WINRM_SESSION = None
    REMOTE_MODE = False


def ensure_dir(p):
    Path(p).mkdir(parents=True, exist_ok=True)
    return p


def save_file(path, content, mode='w'):
    try:
        with open(path, mode, encoding='utf-8', errors='ignore') as f:
            f.write(content)
        return True
    except Exception as e:
        print(color(f"[!] Error guardando {path}: {e}", C.F))
        return False


def next_report_id(prefix):
    global REPORT_COUNTER
    REPORT_COUNTER += 1

    # Validación anti-duplicado: buscar siguiente número libre
    informes_dir = os.path.join(audit_data.get("output_dir", "."), "informes")
    while True:
        report_id = f"ISO27001-{prefix}-{REPORT_COUNTER:03d}"
        json_path = os.path.join(informes_dir, f"{report_id}.json")
        txt_path = os.path.join(informes_dir, f"{report_id}.txt")
        if not os.path.exists(json_path) and not os.path.exists(txt_path):
            break
        REPORT_COUNTER += 1  # Saltar al siguiente si ya existe

    return report_id


def hash_file(filepath):
    try:
        h = hashlib.sha256()
        with open(filepath, 'rb') as f:
            for chunk in iter(lambda: f.read(8192), b""):
                h.update(chunk)
        return h.hexdigest()
    except Exception:
        return "N/A"


def generate_iso_report(report_id, control_iso, titulo, descripcion,
                        hallazgos, evidencias, datos_tecnicos,
                        cumplimiento, severidad, recomendaciones,
                        referencias=None):
    if referencias is None:
        referencias = ["ISO/IEC 27001:2022", "ISO/IEC 27002:2022"]
    timestamp = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    
    report = {
        "id_informe": report_id, "fecha_hora": timestamp,
        "organizacion": audit_data["organizacion"], "auditor": audit_data["auditor"],
        "alcance": audit_data["alcance"], "ip_objetivo": audit_data["ip_objetivo"],
        "dominio": audit_data["dominio"], "hostname": audit_data["hostname"],
        "control_iso": control_iso, "titulo_prueba": titulo,
        "descripcion": descripcion, "hallazgos": hallazgos,
        "evidencia_recopilada": evidencias, "datos_tecnicos": datos_tecnicos,
        "nivel_cumplimiento": cumplimiento, "severidad": severidad,
        "recomendaciones": recomendaciones, "referencias": referencias,
        "hash_integridad": "", "version_script": SCRIPT_VERSION
    }
    
    json_path = os.path.join(audit_data["output_dir"], "informes", f"{report_id}.json")
    ensure_dir(os.path.dirname(json_path))
    save_file(json_path, json.dumps(report, indent=4, ensure_ascii=False))
    report["hash_integridad"] = hash_file(json_path)
    save_file(json_path, json.dumps(report, indent=4, ensure_ascii=False))
    
    nl = "\n"
    txt = f"""
{'='*80}
INFORME DE AUDITORIA - ISO/IEC 27001:2022
{'='*80}
ID Informe:        {report_id}
Fecha/Hora:        {timestamp}
Organizacion:      {audit_data['organizacion']}
Auditor:           {audit_data['auditor']}
Alcance:           {audit_data['alcance']}
IP Objetivo:       {audit_data['ip_objetivo']}
Dominio:           {audit_data['dominio']}
Hostname:          {audit_data['hostname']}
Control ISO:       {control_iso}
{'='*80}
TITULO DE PRUEBA
{'='*80}
{titulo}

DESCRIPCION
{'='*80}
{descripcion}

HALLAZGOS
{'='*80}
{hallazgos}

DATOS TECNICOS / EVIDENCIA BRUTA
{'='*80}
{datos_tecnicos[:50000] if datos_tecnicos else 'N/A'}

EVIDENCIA RECOPILADA
{'='*80}
{nl.join(evidencias) if evidencias else 'N/A'}

NIVEL DE CUMPLIMIENTO: {cumplimiento}
SEVERIDAD:             {severidad}

RECOMENDACIONES
{'='*80}
{recomendaciones}

REFERENCIAS
{'='*80}
{nl.join(referencias)}

HASH DE INTEGRIDAD (SHA-256): {report['hash_integridad']}
Generado con: ISO27001 Auditor v{SCRIPT_VERSION}
{'='*80}
"""
    txt_path = os.path.join(audit_data["output_dir"], "informes", f"{report_id}.txt")
    save_file(txt_path, txt)
    print(color(f"    [+] Informe: {report_id}", C.G))
    return json_path, txt_path
def check_privileges():
    global SUDO_CACHED, IS_ADMIN
    if os.name == 'nt':
        try:
            import ctypes
            IS_ADMIN = ctypes.windll.shell32.IsUserAnAdmin() != 0
        except Exception:
            pass
        if not IS_ADMIN:
            print(color("[!] ADVERTENCIA: No se detecto ejecucion como Administrador", C.W))
            print(color("[!] Algunas evidencias no seran accesibles.\n", C.W))
        else:
            print(color("[+] Privilegios de Administrador confirmados", C.G))
        return
    if hasattr(os, 'geteuid') and os.geteuid() == 0:
        IS_ADMIN = True
        SUDO_CACHED = True
        print(color("[+] Ejecutando como root", C.G))
        return
    print(color("[*] Verificando acceso sudo...", C.C))
    ret, _, _ = run_cmd("sudo -n true", timeout=10)
    if ret == 0:
        SUDO_CACHED = True
        print(color("[+] Cache sudo disponible", C.G))
        return
    print(color("[!] Se requieren privilegios elevados.", C.W))
    try:
        pwd = getpass.getpass("    Contrasena sudo: ")
        proc = subprocess.run(["sudo", "-S", "-v"], input=pwd + "\n",
                              capture_output=True, text=True, timeout=30)
        if proc.returncode == 0:
            SUDO_CACHED = True
            print(color("[+] Privilegios sudo cacheados", C.G))
        else:
            print(color("[!] No se pudo autenticar con sudo.", C.F))
    except (EOFError, KeyboardInterrupt):
        print(CTRL_Z_MSG)
        raise
    except Exception as e:
        print(color(f"[!] Error con sudo: {e}", C.F))


LINUX_TOOLS = {
    "journalctl": {"pkg": "systemd", "critico": True, "desc": "Logs systemd (A.12.4.1)", "ctrl": "A.12.4"},
    "last": {"pkg": "util-linux", "critico": True, "desc": "Historial logins (A.9.4.2)", "ctrl": "A.9.4"},
    "lastlog": {"pkg": "login", "critico": True, "desc": "Ultimo login (A.9.4.2)", "ctrl": "A.9.4"},
    "dmesg": {"pkg": "util-linux", "critico": False, "desc": "Mensajes kernel (A.12.4.1)", "ctrl": "A.12.4"},
    "ss": {"pkg": "iproute2", "critico": True, "desc": "Conexiones red (A.13.1.1)", "ctrl": "A.13.1"},
    "netstat": {"pkg": "net-tools", "critico": False, "desc": "Estadisticas red (A.13.1.1)", "ctrl": "A.13.1"},
